# =============================================================================
# FreshGuard (SporeWatch) Environment Configuration
# Copy this file to .env and adjust variables as needed.
# =============================================================================

# MongoDB connection URI (default: mongodb://localhost:27017)
MONGO_URI=mongodb://localhost:27017

# MongoDB database name (default: freshguard)
MONGO_DB=freshguard

# Web dashboard port (default: 5000)
PORT=5000

# Serial communication defaults
SERIAL_PORT=COM5
SERIAL_BAUD=115200

# Specimen default identifier
DEFAULT_SPECIMEN=BANANA-LIVE
